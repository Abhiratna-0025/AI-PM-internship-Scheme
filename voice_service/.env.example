# WeatherGPT Voice Service Configuration

# Enable/disable voice services (STT/TTS)
# Set to true to enable server-side voice processing
# When false, services run in no-op mode (matching Java NoOp* behavior)
VOICE_ENABLED=false

# STT Configuration
# Whisper model size: tiny, base, small, medium, large
# Larger models are more accurate but slower and use more memory
WHISPER_MODEL_SIZE=base

# TTS Configuration
# Default audio format for TTS output
DEFAULT_TTS_FORMAT=audio/wav

# Server Configuration
HOST=0.0.0.0
PORT=8001
